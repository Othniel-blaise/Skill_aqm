# Copier ce fichier en .env et remplir. Ne jamais partager ni committer .env

# Adresse de l'ERP, sans / final (ex. https://aqm.monentreprise.com)
AQM_SITE=

# Utilisateur tel qu'affiché dans la liste de connexion : initiales, nom ou libellé complet
AQM_USER=
AQM_PASSWORD=

# Libellé exact du rapport PDF sur la fiche d'un bon de commande (menu Rapports)
AQM_RAPPORT_BONS_COMMANDE=
